# Copy this file to ".env" and fill in values. Do not commit ".env" (it is gitignored).
# Used by Docker Compose: https://docs.docker.com/compose/environment-variables/set-environment-variables/

ABACUS_API_KEY=
ABACUS_DEPLOYMENT_IDS=
ABACUS_EXTERNAL_APPLICATION_IDS=
ABACUS_CONVERSATION_TYPES=
APP_ALLOW_UI_API_KEY=true
APP_ALLOW_PERSISTENT_API_KEY=true
# WARNING: both empty = no authentication at all. That is only acceptable while
# the port stays bound to 127.0.0.1 (see compose.yaml). Setting only one of the
# two is refused at startup. Set BOTH before exposing the service on the LAN.
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=

# ---------------------------------------------------------------------------
# Added 2026-07-30 while writing docs/ — completes the list of variables that
# the code actually reads. All of these are optional; the defaults shown in
# brackets are the ones applied by the code or the image. Nothing below is a
# secret. See docs/08-konfiguration.md for the full table with source lines.
# ---------------------------------------------------------------------------

# Root directory for ALL persisted data: app.db, backups/, secrets/, settings/.
# [default: /data] Set explicitly when running WITHOUT Docker Compose — otherwise
# the app writes to /data relative to the filesystem root (on Windows: C:\data).
# Read in backend/app/config.py:59
APP_DATA_DIR=

# Directory holding the built React bundle. If it does not exist, the app serves
# the API only — no web UI and no SPA fallback route.
# [default: /app/static, already set in the image via Dockerfile:13]
# Read in backend/app/config.py:68 and backend/app/main.py:431
APP_STATIC_DIR=

# Optional build metadata. When set, GET /api/health returns it as "commit".
# When unset, the field is omitted — the value is never invented.
# Read in backend/app/main.py:65
APP_COMMIT=

# Fallback name for APP_COMMIT. APP_COMMIT wins if both are set.
# Read in backend/app/main.py:65
GIT_COMMIT=

# NOT read by the application. Only interpolated into the Docker label
# homelab.version for the HomeLAB_UX dashboard. [default: dev]
# Used in compose.yaml:39
APP_VERSION=
